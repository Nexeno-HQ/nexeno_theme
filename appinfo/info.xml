	<licence>agpl</licence>
	<author mail="TODO-author@example.com" homepage="https://TODO-website.example.com">Nexeno</author>
	<namespace>NexenoTheme</namespace>
	<category>customization</category>
	<website>https://TODO-website.example.com</website>
	<bugs>https://github.com/TODO-owner/nexeno_theme/issues</bugs>
	<repository type="git">https://github.com/TODO-owner/nexeno_theme</repository>
	<screenshot>https://raw.githubusercontent.com/TODO-owner/nexeno_theme/main/img/showcase/dashboard.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/TODO-owner/nexeno_theme/main/img/showcase/files.png</screenshot>
	<screenshot>https://raw.githubusercontent.com/TODO-owner/nexeno_theme/main/img/showcase/photos.png</screenshot>
