{
	"name": "nexeno/nexeno_theme",
	"description": "Nexeno Light and Dark colour themes for Nextcloud",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"autoload": {
		"psr-4": {
			"OCA\\NexenoTheme\\": "lib/"
		}
	},
	"require": {
		"php": ">=8.1 <8.6"
	},
	"require-dev": {
		"nextcloud/coding-standard": "^1.3",
		"nextcloud/ocp": "dev-stable32",
		"phpunit/phpunit": "^13.4",
		"vimeo/psalm": "^6.0"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true
	},
	"scripts": {
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './node_modules/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --no-cache --threads=1",
		"psalm:update-baseline": "psalm --no-cache --threads=1 --update-baseline",
		"test:unit": "phpunit -c tests/phpunit.xml"
	}
}
