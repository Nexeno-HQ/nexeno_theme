<psalm
		errorLevel="4"
		resolveFromConfigFile="true"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xmlns="https://getpsalm.org/schema/config"
		xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
		findUnusedBaselineEntry="true"
		findUnusedCode="false"
		phpVersion="8.1"
>
	<projectFiles>
		<directory name="lib" />
		<ignoreFiles>
			<directory name="vendor" />
		</ignoreFiles>
	</projectFiles>
	<extraFiles>
		<directory name="vendor" />
	</extraFiles>
	<issueHandlers>
		<!-- Private OC classes ship with the server, not with nextcloud/ocp. Each use is a fragile dependency: keep the list short. -->
		<UndefinedClass>
			<errorLevel type="suppress">
				<referencedClass name="OC\Security\CSP\ContentSecurityPolicyNonceManager" />
			</errorLevel>
		</UndefinedClass>
		<UndefinedDocblockClass>
			<errorLevel type="suppress">
				<referencedClass name="OC\Security\CSP\ContentSecurityPolicyNonceManager" />
			</errorLevel>
		</UndefinedDocblockClass>
		<MissingDependency errorLevel="suppress" />
		<!-- #[\Override] needs PHP 8.3; the app still supports older PHP versions. -->
		<MissingOverrideAttribute errorLevel="suppress" />
	</issueHandlers>
</psalm>
